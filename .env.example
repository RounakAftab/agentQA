# On a pooled host (Neon) DATABASE_URL is the pooled string and DIRECT_URL the direct one.
DATABASE_URL="postgresql://agentqa:agentqa@localhost:54329/agentqa"
DIRECT_URL="postgresql://agentqa:agentqa@localhost:54329/agentqa"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

APP_URL="http://localhost:3000"

# Leave SMTP_HOST empty in development to write invitation emails to ./.mail-outbox.
MAIL_FROM="AgentQA <no-reply@your-domain.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# First administrator, created by "npm run db:seed" (they get an email to choose a password).
ADMIN_NAME=""
ADMIN_EMAIL=""

# ---- QA Agent (the "QA Agent" menu and npm run agent:worker) ----
# Jira Cloud. Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL="https://your-team.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""
# Status names in your Jira workflow (defaults shown).
JIRA_STATUS_IN_PROGRESS="In Progress"
JIRA_STATUS_DONE="Done"

# Worker only. Claude model and limits for each ticket.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-opus-5-5"
AGENT_MAX_BUDGET_USD="10"
AGENT_MAX_TEST_RUNS="6"

# Worker only. Lets the worker clone private test repos, push the branch and open a draft PR.
# Fine-grained token with Contents and Pull requests: read and write on the test repositories.
GITHUB_TOKEN=""

# Worker only. Test account for the application under test. Generated specs read these
# from process.env; they are never written into test files.
E2E_USERNAME=""
E2E_PASSWORD=""
