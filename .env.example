# On a pooled host (Neon) DATABASE_URL is the pooled string and DIRECT_URL the direct one.
DATABASE_URL="postgresql://agentqa:agentqa@localhost:54329/agentqa"
DIRECT_URL="postgresql://agentqa:agentqa@localhost:54329/agentqa"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

APP_URL="http://localhost:3000"

# Leave SMTP_HOST empty in development to write invitation emails to ./.mail-outbox.
MAIL_FROM="AgentQA <no-reply@your-domain.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# First administrator, created by "npm run db:seed" (they get an email to choose a password).
ADMIN_NAME=""
ADMIN_EMAIL=""

# ---- QA Agent (the "QA Agent" menu and npm run agent:worker) ----
# Jira connections and test accounts are set per project in the app (Projects > Edit > Jira).
# Their secrets are encrypted with this key. Optional: without it SESSION_SECRET is used.
# The app and the worker must use the same value, and changing it means re-entering the
# saved Jira tokens and test passwords.
ENCRYPTION_KEY=""

# Worker only. Claude model and limits for each ticket. These defaults are the low-cost mode:
# a cheap model and a hard spending cap per run (the run stops and fails if it would exceed it).
# For long or tricky flows, try AGENT_MODEL="claude-sonnet-5-5" or "claude-opus-5-5" and a higher cap.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-haiku-5-5"
AGENT_MAX_BUDGET_USD="0.30"
AGENT_MAX_TURNS="40"
AGENT_MAX_TEST_RUNS="3"

# Worker only. Lets the worker clone private test repos, push the branch and open a draft PR.
# Fine-grained token with Contents and Pull requests: read and write on the test repositories.
GITHUB_TOKEN=""
