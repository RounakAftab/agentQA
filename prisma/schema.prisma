// Prisma schema for Agentic QA Operations Platform
// Represents the enterprise data model for projects, AI workflows, checkpoints, test cases, and audit trails

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // non-pooled connection used by migrations (same as DATABASE_URL locally)
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  QA_LEAD
  QA_ENGINEER
  DEVELOPER
}

enum ProjectHealth {
  HEALTHY
  WARNING
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUPERSEDED // a newer QA Agent run of the same ticket replaced it before a decision
}

enum WorkflowStatus {
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum CIStatus {
  PASSED
  FAILED
  RUNNING
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(QA_ENGINEER)
  avatar       String?
  disabled     Boolean   @default(false)
  passwordHash String? // null until the invited user sets a password
  deletedAt    DateTime? // soft delete keeps names in history
  lastLoginAt  DateTime?
  keycloakId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects          ProjectMember[]
  approvals         Approval[]         @relation("AssignedApprovals")
  approvedItems     Approval[]         @relation("ApprovedBy")
  auditEvents       AuditEvent[]
  comments          Comment[]
  passwordTokens    PasswordToken[]
  agentRuns         AgentRun[]
  requirements      Requirement[]
  codegenScripts    CodegenScript[]
  codegenRecordings CodegenRecording[]
  codegenRuns       CodegenRun[]
}

model PasswordToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token; the raw token is never stored
  purpose   String    @default("invite") // invite | reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                   String        @id @default(cuid())
  name                 String
  description          String
  repoUrl              String? // optional: a project can be Jira-only or manual
  automationRepoUrl    String
  defaultBranch        String        @default("main")
  language             String
  framework            String
  health               ProjectHealth @default(HEALTHY)
  testCoverage         Float         @default(0.0)
  // Jira Cloud connection used by the QA Agent. Secrets are encrypted (src/lib/secrets.js)
  // and never sent to the browser.
  jiraBaseUrl          String? // https://your-team.atlassian.net
  jiraEmail            String?
  jiraApiTokenEnc      String?
  jiraProjectKey       String? // e.g. "SCRUM"
  jiraStatusInProgress String? // status names in this project's workflow; null = "In Progress"
  jiraStatusDone       String? // null = "Done"
  // Application the generated Playwright tests run against, and its test account.
  appBaseUrl           String?
  e2eUsername          String?
  e2ePasswordEnc       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members      ProjectMember[]
  requirements Requirement[]
  testCases    TestCase[]
  workflowRuns WorkflowRun[]
  ciRuns       CIRun[]
  auditEvents  AuditEvent[]
  agentRuns    AgentRun[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// Something to test: a Jira ticket (key "SCRUM-12") or a requirement written in AgentQA
// (key "REQ-3"). The QA Agent runs against either.
model Requirement {
  id             String   @id @default(cuid())
  projectId      String
  key            String? // "SCRUM-12" or "REQ-3"; unique within the project
  title          String
  description    String?  @db.Text // the requirement text for manual requirements
  source         String // "jira" | "manual" (older rows hold free text)
  sourceUrl      String?
  status         String   @default("analyzed")
  priority       String   @default("medium")
  generatedTests Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  testCases    TestCase[]
  workflowRuns WorkflowRun[]
  agentRuns    AgentRun[]

  @@unique([projectId, key])
}

model TestCase {
  id               String         @id @default(cuid())
  projectId        String
  requirementId    String?
  title            String
  type             String // functional, integration, regression, e2e
  priority         String         @default("medium")
  status           ApprovalStatus @default(PENDING)
  aiGenerated      Boolean        @default(true)
  automationStatus String         @default("pending") // pending, scripted
  lastResult       String? // pass, fail, null
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  approvals   Approval[]
}

model WorkflowRun {
  id            String         @id @default(cuid())
  projectId     String
  requirementId String?
  title         String
  status        WorkflowStatus @default(IN_PROGRESS)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement?         @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  checkpoints WorkflowCheckpoint[]
}

model WorkflowCheckpoint {
  id            String   @id @default(cuid())
  workflowRunId String
  stepIndex     Int
  stepName      String
  state         String // serialized LangGraph state
  savedAt       DateTime @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
}

model Approval {
  id           String         @id @default(cuid())
  projectId    String
  testCaseId   String?
  type         String // test_design, automation_script, draft_pr
  title        String
  description  String
  status       ApprovalStatus @default(PENDING)
  requestedBy  String // "AI Agent"
  assignedToId String? // null = any QA lead or admin may decide
  approvedById String? // who made the latest decision (approve, request changes or reject)
  decidedAt    DateTime?
  agentRunId   String?        @unique // the QA Agent run whose verified spec is under review
  aiConfidence Float          @default(0.9)
  codePreview  String         @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("AssignedApprovals", fields: [assignedToId], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  comments   Comment[]

  @@index([status, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  approvalId String
  userId     String
  text       String
  createdAt  DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CIRun {
  id            String    @id @default(cuid())
  projectId     String
  branch        String
  commit        String
  commitMessage String
  status        CIStatus  @default(RUNNING)
  triggeredBy   String    @default("push")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  duration      Int? // seconds
  totalTests    Int       @default(0)
  passed        Int       @default(0)
  failed        Int       @default(0)
  skipped       Int       @default(0)
  coverage      Float     @default(0.0)
  runUrl        String? // the GitHub Actions run that produced this report
  externalId    String? // "<run id>-<attempt>"; a re-sent report updates the same row

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  failures CIFailure[]

  @@unique([projectId, externalId])
  @@index([projectId, startedAt])
}

model CIFailure {
  id         String  @id @default(cuid())
  ciRunId    String
  testName   String
  className  String
  error      String  @db.Text
  duration   Float
  aiAnalysis String? @db.Text // likely cause, from src/lib/playwrightReport.js

  ciRun CIRun @relation(fields: [ciRunId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  action    String
  target    String
  details   String
  timestamp DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

// One QA Agent run: a Jira ticket turned into a verified Playwright spec. Created by the API,
// claimed and executed by the worker (agent/worker.mjs).
model AgentRun {
  id              String         @id @default(cuid())
  projectId       String
  issueKey        String // requirement key: "SCRUM-12" (Jira) or "REQ-3" (manual)
  source          String         @default("jira") // "jira" | "manual"
  requirementId   String?
  skippedSteps    String[]       @default([]) // steps that did not apply, e.g. no Jira or no test repo
  issueSummary    String         @default("")
  issueSnapshot   Json? // the ticket as read when the run started
  testPlan        Json? // { flow, steps[], acceptanceCriteria[] } submitted by the agent
  specPath        String? // tests/generated/scrum_12.spec.ts
  specContent     String?        @db.Text
  status          AgentRunStatus @default(QUEUED)
  step            String? // current pipeline step, see src/lib/agentSteps.js
  verifiedPass    Boolean        @default(false) // set only by the worker's own test run
  testAttempts    Int            @default(0)
  branch          String?
  prUrl           String?
  costUsd         Float?
  error           String?        @db.Text
  cancelRequested Boolean        @default(false)
  startedById     String?
  workerId        String?
  heartbeatAt     DateTime?
  queuedAt        DateTime       @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy   User?           @relation(fields: [startedById], references: [id], onDelete: SetNull)
  requirement Requirement?    @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  events      AgentRunEvent[]
  approval    Approval?

  @@index([status, queuedAt])
  @@index([projectId, issueKey])
}

model AgentRunEvent {
  id      String   @id @default(cuid())
  runId   String
  step    String
  level   String   @default("info") // info | warn | error | success
  message String   @db.Text
  at      DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
}

// A Playwright codegen recording, turned into a plain spec or a Page Object Model project by
// src/lib/codegen. The code is rebuilt from `recording` and `edits` on every view, so improving the
// converter improves every saved script.
model CodegenScript {
  id             String   @id @default(cuid())
  title          String
  startUrl       String
  sourceCode     String   @db.Text // recorder output with typed credentials already replaced
  recording      Json // { steps, startUrl, preamble, secrets } from parseCodegen()
  edits          Json     @default("{}") // { removed, pageNames, renames } made in the editor
  // Test login for runs (E2E_USERNAME / E2E_PASSWORD). The password is encrypted (src/lib/secrets.js).
  e2eUsername    String?
  e2ePasswordEnc String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      CodegenRun[]

  @@index([updatedAt])
}

// A test run or heal of a Codegen script, done by the worker (agent/codegenRunner.mjs).
//   kind "run":  runs the generated code; `console` streams the output, `results` the steps.
//   kind "heal": the healer fixes the recording after a failed run (`fromRunId`), then runs it;
//                the fix is kept in `healedSource` until the user applies it.
//   status: QUEUED -> RUNNING -> PASSED | FAILED | ERROR | CANCELLED
model CodegenRun {
  id              String    @id @default(cuid())
  scriptId        String
  kind            String    @default("run")
  style           String    @default("pom") // pom | plain
  headed          Boolean   @default(false)
  fromRunId       String?
  status          String    @default("QUEUED")
  console         String    @default("") @db.Text
  results         Json? // { status, duration, tests: [{ title, status, duration, error, steps, screenshot }] }
  healedSource    String?   @db.Text
  healSummary     String?   @db.Text
  appliedAt       DateTime?
  costUsd         Float?
  error           String?   @db.Text
  cancelRequested Boolean   @default(false)
  workerId        String?
  hostname        String?
  requestedById   String?
  heartbeatAt     DateTime?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  script      CodegenScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  requestedBy User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([scriptId, createdAt])
  @@index([status, createdAt])
}

// A live recording: the worker opens Playwright's recorder on its machine (agent/recorder.mjs),
// streams the code here while the user works, and finishes when they close the browser. The app
// then turns the code into a CodegenScript.
//   QUEUED -> RECORDING -> DONE -> SAVING -> SAVED, or FAILED / CANCELLED
model CodegenRecording {
  id              String    @id @default(cuid())
  title           String
  startUrl        String
  status          String    @default("QUEUED")
  liveCode        String?   @db.Text // recorder output so far, with typed credentials already replaced
  stepCount       Int       @default(0)
  error           String?   @db.Text
  scriptId        String? // the CodegenScript created from it
  cancelRequested Boolean   @default(false)
  workerId        String?
  hostname        String? // the computer the recorder opened on
  requestedById   String?
  heartbeatAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Last time each worker process checked in, so the UI can say whether one is running.
model AgentWorker {
  id         String   @id
  hostname   String
  lastSeenAt DateTime @default(now())
}

// Failed-login counters. Stored in the database so the lockout works across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
